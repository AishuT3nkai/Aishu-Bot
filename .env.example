DISCORD_TOKEN=your_bot_token_here

# Dashboard admins
ADMIN_USER_ID_1=
ADMIN_USER_ID_2=
ADMIN_GUILD_ID=

# Private HTTP bridge used by the Vercel dashboard.
# Keep this secret identical on the dashboard and bot host.
BOT_API_SHARED_SECRET=
# Nexus Host/reverse-proxy should expose this port to the dashboard.
BOT_API_HOST=0.0.0.0
BOT_API_PORT=8080

# Required for webhook endpoint/signing-secret encryption at rest.
# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this key stable; changing it makes existing webhook secrets unreadable.
BOT_WEBHOOK_ENCRYPTION_KEY=
