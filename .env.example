DISCORD_TOKEN=your_bot_token_here

# Dashboard admins
ADMIN_USER_ID_1=
ADMIN_USER_ID_2=
ADMIN_GUILD_ID=

# Private HTTP bridge used by the Vercel dashboard.
# Generate a random secret with: openssl rand -hex 32
# Keep this secret identical on the dashboard and bot host (minimum 32 characters).
BOT_API_SHARED_SECRET=
# Expose this port only through a private HTTPS reverse proxy/firewall path;
# do not publish the raw bridge port to the public internet.
BOT_API_HOST=0.0.0.0
BOT_API_PORT=8080
